{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AoE",
  "version": "0.1.0",
  "identifier": "tw.kigi.aoe",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AoE", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/kigichang/aoe/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGMEUzREJCOTgxREFBNEMKUldSTXFoMll1ejBPNzVXSDlPRytZbVBHR0NIVFB6bFRqbzE1cCtCQzh5cGpWOW85KzVLMERxYjMK"
    }
  }
}
